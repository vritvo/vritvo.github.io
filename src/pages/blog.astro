---
import "../styles/globals.css";
const pageTitle = "Blog";
import Navigation from "../components/navigation.astro";
import Footer from "../components/footer.astro";
import { getCollection } from "astro:content";

const blogPosts = (await getCollection("blog"))
    .sort((a: any, b: any) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/x-icon" href="/favicon_io/favicon.ico" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon_io/favicon-32x32.png" />
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon_io/favicon-16x16.png" />
        <link rel="apple-touch-icon" sizes="180x180" href="/favicon_io/apple-touch-icon.png" />
        <link rel="manifest" href="/favicon_io/site.webmanifest" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <link
            rel="alternate"
            type="application/rss+xml"
            title="Victoria Ritvo"
            href="/rss.xml"
        />
        <title>{pageTitle}</title>
    </head>
    <body>
        <div class="container">
            <Navigation />
            <div class="content-wrapper">
                <main>
                    <h1 class="blog-title">
                        {pageTitle}
                        <a href="/rss.xml" class="rss-link" aria-label="RSS feed" title="RSS feed">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1" />
                            </svg>
                        </a>
                    </h1>
                    <ul class="blog-list">
                        {
                            blogPosts.map((post: any) => (
                                <li class="blog-list-item">
                                    <a href={`/blog/${post.id}`} class="blog-list-link">
                                        <span class="blog-list-title">{post.data.title}</span>
                                        <time class="blog-list-date" datetime={post.data.pubDate.toISOString().split('T')[0]}>
                                            {new Date(post.data.pubDate.toISOString().split('T')[0] + 'T12:00:00').toLocaleDateString("en-US", {
                                                year: "numeric",
                                                month: "short",
                                                day: "numeric",
                                            })}
                                        </time>
                                    </a>
                                    <p class="blog-list-description">{post.data.description}</p>
                                </li>
                            ))
                        }
                    </ul>
                </main>
                <Footer />
            </div>
        </div>
    </body>
</html>

<style>
    .blog-title {
        display: flex;
        align-items: baseline;
        gap: 0.35em;
    }

    .rss-link {
        color: var(--accent-500);
        text-decoration: none;
        line-height: 0;
    }

    .rss-link svg {
        width: 0.4em;
        height: 0.4em;
    }

    .rss-link:hover {
        color: var(--accent-200);
        background: transparent;
    }

    .blog-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .blog-list-item {
        padding: 1rem 0;
        border-bottom: 1px solid #e5e0d8;
    }

    .blog-list-item:last-child {
        border-bottom: none;
    }

    .blog-list-link {
        text-decoration: none;
        color: inherit;
        display: block;
    }

    .blog-list-title {
        font-size: 1.15rem;
        font-weight: 600;
    }

    .blog-list-link:hover .blog-list-title {
        text-decoration: underline;
    }

    .blog-list-link:hover .blog-list-date {
        color: var(--color-background);
    }

    .blog-list-date {
        font-size: 0.9rem;
        color: #666;
        margin-left: 0.5rem;
    }

    .blog-list-description {
        margin: 0.35rem 0 0;
        font-size: 0.95rem;
        color: #555;
        line-height: 1.5;
    }
</style>
